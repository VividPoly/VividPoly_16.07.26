# --- Core ---
NODE_ENV=production
JWT_SECRET=change-me

# --- Supabase (blogs + contact inquiries) ---
# Server reads with the service role key when present (bypasses RLS for admin
# reads); otherwise the anon key is used and RLS limits reads to published blogs.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Optional, server-only. Do NOT expose to the browser.
SUPABASE_SERVICE_KEY=your-service-role-key

# --- Odoo CRM (leads from inquiry / contact / quote forms) ---
# Leave blank to disable CRM push (forms still email + save to Supabase).
ODOO_URL=https://your-company.odoo.com
ODOO_DATABASE=your-odoo-db
ODOO_USERNAME=your-odoo-login
ODOO_API_KEY=your-odoo-api-key-or-password

# --- Optional integrations ---
# OAuth (staff login); leave blank to disable.
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
VITE_APP_ID=
