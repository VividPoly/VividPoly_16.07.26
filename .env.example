# VividPoly — environment variables (Vite + Express + tRPC + MySQL stack)
# Copy to .env for local development. Set the same values in your host
# (Vercel → Project → Settings → Environment Variables, or Render/Railway).

# --- Required ---
# Secret used to sign session cookies. Any long random string.
JWT_SECRET=

# --- Database (MySQL) — blog posts + saved inquiries ---
# The site renders fully without this (product/marketing content is static);
# a DATABASE_URL is only needed for admin-published blogs and stored inquiries.
DATABASE_URL=

# --- File storage for inquiry attachments (optional) ---
# S3-compatible upload backend used by /api/upload.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# --- Owner / admin login (optional; off by default) ---
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# Port for the local/prod Node server (defaults to 3000).
PORT=3000
