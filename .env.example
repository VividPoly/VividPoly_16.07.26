# VividPoly Next.js — environment variables
# Copy to .env.local for local development. Set the same values in Vercel → Project → Settings → Environment Variables.

# Public site URL (used for OAuth redirect when GOOGLE_OAUTH_REDIRECT_URI is unset)
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# --- Supabase (blog content published from the admin_Vivid app) ---
# Same Supabase project as the admin app. The public (anon) key is used for
# read-only blog fetches in the browser. Leave blank to fall back to the
# built-in static blog list.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (never prefix NEXT_PUBLIC_): lets /api/translate-blog write blog
# translations back into the blogs.translations column so they persist and are
# shared across visitors. Optional — omit and translations still work per-view
# (in-memory + session cache) without being saved to the database.
SUPABASE_SERVICE_ROLE_KEY=

# --- Gmail API (server-side contact form) ---
# 1. Google Cloud Console → APIs & Services → Enable Gmail API
# 2. Create OAuth 2.0 Client ID (Web application)
# 3. Authorized redirect URI must match GOOGLE_OAUTH_REDIRECT_URI below
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/api/gmail/oauth/callback

# One-time: visit /api/gmail/oauth/start after setting client id/secret, sign in as the sending Gmail account
GOOGLE_REFRESH_TOKEN=

# Gmail account that sends enquiries (must match the account used for OAuth)
GMAIL_SENDER_EMAIL=info@vividpoly.com
GMAIL_INBOX_TO=info@vividpoly.com

# Optional: protect OAuth setup routes in production (?key=...)
GMAIL_OAUTH_SETUP_KEY=

# --- Odoo CRM (server-side — every website lead form creates a crm.lead) ---
# Server-only (no NEXT_PUBLIC_ prefix), so the API key is never sent to the
# browser. Leave blank to disable Odoo (forms then only send the Gmail email).
# Get the API key: Odoo → My Profile → Account Security → New API Key.
ODOO_URL=https://your-company.odoo.com
ODOO_DATABASE=your-database-name
ODOO_USERNAME=info@your-company.com
ODOO_API_KEY=

# Optional: override URL for responsive audit script (scripts/responsive-audit.mjs)
# VP_AUDIT_URL=http://localhost:3000
